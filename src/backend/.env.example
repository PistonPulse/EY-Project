# TataSmartAgent v3.0 - Environment Configuration

# ==================== GOOGLE GEMINI API ====================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==================== SERVER CONFIGURATION ====================
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# ==================== CORS SETTINGS ====================
# In production, replace * with your frontend domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ==================== SESSION SETTINGS ====================
# Session timeout in seconds (default: 1 hour)
SESSION_TIMEOUT=3600

# ==================== RATE LIMITING ====================
# Maximum requests per minute per session
RATE_LIMIT_PER_MINUTE=30

# ==================== WEBSOCKET SETTINGS ====================
# Maximum admin connections
MAX_ADMIN_CONNECTIONS=10

# ==================== LOGGING ====================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/tatasmartag ent.log

# ==================== SECURITY ====================
# JWT Secret for admin authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# ==================== DATABASE (Optional - for production) ====================
# Uncomment and configure when using persistent storage
# DATABASE_URL=postgresql://user:password@localhost:5432/tatasmartag ent
# REDIS_URL=redis://localhost:6379/0

# ==================== EXTERNAL SERVICES (Optional) ====================
# Cloud Storage for document uploads
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=tatasmartag ent-documents
# AWS_REGION=ap-south-1

# Google Cloud Document AI for OCR
# GOOGLE_CLOUD_PROJECT_ID=your_project_id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==================== MONITORING (Optional) ====================
# Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn_here

# ==================== FEATURE FLAGS ====================
ENABLE_TRUST_ANALYSIS=true
ENABLE_DOCUMENT_UPLOAD=true
ENABLE_ADMIN_DASHBOARD=true
ENABLE_WEBSOCKET_STREAM=true
